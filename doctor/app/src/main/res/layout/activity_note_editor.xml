<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Note Title"
            app:menu="@menu/menu_note_editor" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Full-screen Markdown Writing Area -->
        <EditText
            android:id="@+id/etNoteContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:hint="Start typing markdown (select text to format)..."
            android:inputType="textMultiLine|textCapSentences"
            android:fontFamily="monospace"
            android:textSize="15sp"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:scrollbars="vertical"
            android:importantForAutofill="no" />

        <!-- Full-screen Preview Area -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollPreviewArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvEditorPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:lineSpacingMultiplier="1.25"
                android:textIsSelectable="true" />

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</LinearLayout>
